# Application Environment Configuration
APP_NAME="AI Circular Economy Marketplace"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database (Default uses SQLite for zero-config local run, switch to PostgreSQL as needed)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/circular_economy
DATABASE_URL="postgresql://postgres:sql@localhost:5432/circular_economy"

# Security & Authentication (Required: minimum 32 characters, cryptographically random)
# Generate with: openssl rand -hex 32
JWT_SECRET="your_secure_random_jwt_secret_min_32_characters_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Inference Mode: "production" (requires trained models) or "development" (clean fallback mode)
ML_MODE="production"
MODEL_DIR="ml/models"
UPLOAD_DIR="uploads/materials"

# CORS Configuration (Comma separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
